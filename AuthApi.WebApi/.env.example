# =================================================================
# AUTH API CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or configure in appsettings.Development.json
# DO NOT COMMIT REAL PRODUCTION PASSWORDS TO GIT
# =================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AuthDb
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Settings
JWT_ISSUER=https://auth.company.com
JWT_AUDIENCE=erp-ecosystem
JWT_KEY_ID=auth-key-2026-v1
JWT_EXPIRY_MINUTES=15

# Internal Service-to-Service API Key
INTERNAL_API_KEY=your-internal-service-key
